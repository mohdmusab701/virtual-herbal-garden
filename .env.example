# Reference template only. Applications run from their own directories:
# copy the backend values to backend/.env and the frontend value to
# frontend/.env.local. The FastAPI service reads its variables from the
# process environment; it does not load this file.

# Express backend
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/herbiva_ai
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/herbiva_ai_test
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:8000
MAX_IMAGE_SIZE_MB=10
MOCK_AI_MODE=true

# Optional Cloudinary upload integration; leave blank when unused.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Next.js frontend (public values are bundled into browser code).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional AI training/inference settings; set in the AI service process.
# MODEL_PATH=models/yolo/best.pt
# ROBOFLOW_API_KEY=replace-with-your-Roboflow-key

# Optional Next.js build output override (used by next.config.ts).
# NEXT_DIST_DIR=.next-build
